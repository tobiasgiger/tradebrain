# NQ Pause-Board — lokale Umgebungsvariablen fürs Testen des Skripts
#
# Kopiere diese Datei nach ".env" und trage deinen Key ein:
#   cp .env.example .env
# Danach lokal ausführen (Node 20+):
#   node --env-file=.env scripts/fetch-assessment.mjs
#
# ".env" ist über .gitignore ausgeschlossen und wird NIE eingecheckt.

# --- Pflicht ---------------------------------------------------------------
# Anthropic API-Key (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# --- Optional --------------------------------------------------------------
# Modell überschreiben (Default: claude-sonnet-4-5)
# ANTHROPIC_MODEL=claude-sonnet-4-5

# Board-URL für Push-Links (Default: https://tobiasgiger.github.io/tradebrain/)
# BOARD_URL=https://tobiasgiger.github.io/tradebrain/

# Vorlauf-Fenster in Stunden vor validierten High-Impact-Events.
# Ganze Zahl 0..168; Default 2. Der Wert 0 markiert nur die Event-Stunde rot.
# EVENT_PRE_HOURS=2

# --- Push bei Eskalation nach ROT (optional; leer = kein Push) --------------
# Variante A: ntfy.sh — kein Account nötig. Frei wählbares (geheimes) Topic;
# in der ntfy-App dasselbe Topic abonnieren.
# NTFY_TOPIC=nq-pause-board-deingeheimestopic
# NTFY_SERVER=https://ntfy.sh          # nur bei eigenem ntfy-Server nötig

# Variante B: Telegram — Bot via @BotFather anlegen, Chat-ID ermitteln.
# TELEGRAM_BOT_TOKEN=123456:ABC-...
# TELEGRAM_CHAT_ID=123456789
